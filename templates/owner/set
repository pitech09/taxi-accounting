{% extends 'base.html' %}
{% block title %}Delete Settlement{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trash"></i> Delete Settlement #{{ settlement.id }}</h2>
    <a href="{% url 'owner_settlement_list' %}" class="btn btn-outline-secondary">Cancel</a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <i class="bi bi-exclamation-triangle"></i> Confirm Deletion
    </div>
    <div class="card-body">
        <p>Are you sure you want to delete this settlement? This action cannot be undone.</p>

        <table class="table">
            <tr><th>Date</th><td>{{ settlement.date|date:"d F Y" }}</td></tr>
            <tr><th>Driver</th><td>{{ settlement.driver.name }}</td></tr>
            <tr><th>Vehicle</th><td>{{ settlement.vehicle.name }}</td></tr>
            <tr><th>Status</th><td>{{ settlement.get_status_display }}</td></tr>
            <tr><th>Total Income</th><td class="amount">M {{ settlement.total_income|floatformat:2 }}</td></tr>
            <tr><th>Total Expenses</th><td class="amount">M {{ settlement.total_expenses|floatformat:2 }}</td></tr>
        </table>

        <form method="post" class="mt-3">
            {% csrf_token %}
            <button type="submit" class="btn btn-danger btn-lg">
                <i class="bi bi-trash"></i> Yes, Delete Settlement
            </button>
            <a href="{% url 'owner_settlement_detail' settlement.id %}" class="btn btn-outline-secondary btn-lg">Cancel</a>
        </form>
    </div>
</div>
{% endblock %}