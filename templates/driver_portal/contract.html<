{% extends 'driver_portal/base_driver.html' %}
{% block title %}Contract Progress{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Contract Progress</h2>
    <a href="{% url 'driver_dashboard' %}" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-bullseye"></i></div>
                <div class="stat-value">M {{ target|floatformat:2 }}</div>
                <div class="stat-label">Target</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-graph-up"></i></div>
                <div class="stat-value">M {{ monthly_gross|floatformat:2 }}</div>
                <div class="stat-label">Monthly Gross</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-value">M {{ remaining|floatformat:2 }}</div>
                <div class="stat-label">Remaining</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-percent"></i></div>
                <div class="stat-value">{{ progress }}%</div>
                <div class="stat-label">Progress</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-bar-chart"></i> Progress Overview
    </div>
    <div class="card-body">
        <div class="progress mb-3" style="height: 25px;">
            <div class="progress-bar {% if progress >= 100 %}bg-success{% elif progress < 50 %}bg-danger{% else %}bg-warning{% endif %}" style="width: {{ progress }}%">{{ progress }}%</div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <p class="text-muted">Days Remaining</p>
                <h5>{{ days_remaining }}</h5>
            </div>
            <div class="col-md-6">
                <p class="text-muted">Daily Average Needed</p>
                <h5 class="amount">M {{ daily_average_needed|floatformat:2 }}</h5>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-list-check"></i> This Month's Settlements
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Income</th>
                        <th>Expenses</th>
                        <th>Gross Profit</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in settlements %}
                    <tr>
                        <td>{{ s.date|date:"d M Y" }}</td>
                        <td class="amount">M {{ s.total_income|floatformat:2 }}</td>
                        <td class="amount">M {{ s.total_expenses|floatformat:2 }}</td>
                        <td class="amount">M {{ s.gross_profit|floatformat:2 }}</td>
                        <td>
                            {% if s.status == 'approved' %}
                            <span class="badge bg-success">Approved</span>
                            {% elif s.status == 'submitted' %}
                            <span class="badge bg-warning">Submitted</span>
                            {% else %}
                            <span class="badge bg-secondary">{{ s.status|title }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr><td colspan="5" class="text-center text-muted">No settlements this month</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}