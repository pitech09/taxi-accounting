{% extends 'driver_portal/base_driver.html' %}
{% block title %}My Settlements{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-cash-stack"></i> My Settlement History</h2>
    <a href="{% url 'driver_settlement_create' %}" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Settlement</a>
</div>

<!-- Status Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Draft</h6>
                <h4>{{ status_counts.draft }}</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-warning">
            <div class="card-body">
                <h6 class="text-muted">Submitted</h6>
                <h4 class="text-warning">{{ status_counts.submitted }}</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success">
            <div class="card-body">
                <h6 class="text-muted">Approved</h6>
                <h4 class="text-success">{{ status_counts.approved }}</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-danger">
            <div class="card-body">
                <h6 class="text-muted">Rejected</h6>
                <h4 class="text-danger">{{ status_counts.rejected }}</h4>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="draft" {% if status_filter == 'draft' %}selected{% endif %}>Draft</option>
                    <option value="submitted" {% if status_filter == 'submitted' %}selected{% endif %}>Submitted</option>
                    <option value="approved" {% if status_filter == 'approved' %}selected{% endif %}>Approved</option>
                    <option value="rejected" {% if status_filter == 'rejected' %}selected{% endif %}>Rejected</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">From Date</label>
                <input type="date" name="date_from" class="form-control" value="{{ date_from }}">
            </div>
            <div class="col-md-3">
                <label class="form-label">To Date</label>
                <input type="date" name="date_to" class="form-control" value="{{ date_to }}">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Period</th>
                        <th>Income</th>
                        <th>Expenses</th>
                        <th>Your Pay</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in settlements %}
                    <tr>
                        <td>{{ s.date|date:"d M Y" }}</td>
                        <td>
                            {% if s.settlement_period == 'weekly' %}
                                <span class="badge bg-info">Weekly</span>
                            {% else %}
                                <span class="badge bg-secondary">Daily</span>
                            {% endif %}
                        </td>
                        <td class="amount">M {{ s.total_income|floatformat:2 }}</td>
                        <td class="amount">M {{ s.total_expenses|floatformat:2 }}</td>
                        <td class="amount text-success">
                            {% if s.status == 'approved' %}M {{ s.driver_pay|floatformat:2 }}{% else %}—{% endif %}
                        </td>
                        <td>
                            {% if s.status == 'approved' %}
                                <span class="badge bg-success">Approved</span>
                            {% elif s.status == 'submitted' %}
                                <span class="badge bg-warning">Submitted</span>
                            {% elif s.status == 'rejected' %}
                                <span class="badge bg-danger">Rejected</span>
                            {% else %}
                                <span class="badge bg-secondary">Draft</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{% url 'driver_settlement_view' s.id %}" class="btn btn-sm btn-outline-info">View</a>
                            {% if s.status == 'draft' or s.status == 'rejected' %}
                                <a href="{% url 'driver_settlement_edit' s.id %}" class="btn btn-sm btn-outline-warning">Edit</a>
                            {% endif %}
                            <a href="{% url 'driver_settlement_print' s.id %}" class="btn btn-sm btn-outline-secondary" target="_blank">Print</a>
                        </td>
                    </tr>
                    {% empty %}
                    <tr><td colspan="7" class="text-center text-muted">No settlements found</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}