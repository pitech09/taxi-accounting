{% extends 'base.html' %}
{% block title %}Expense Report{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt"></i> Expense Report</h2>
    <a href="{% url 'report_index' %}" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Reports</a>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-funnel"></i> Filters</div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Start Date</label>
                <input type="date" name="start_date" value="{{ start_date|date:'Y-m-d' }}" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label">End Date</label>
                <input type="date" name="end_date" value="{{ end_date|date:'Y-m-d' }}" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    <option value="fuel">Fuel</option>
                    <option value="maintenance">Maintenance/Repairs</option>
                    <option value="insurance">Insurance</option>
                    <option value="permit">Permit/License</option>
                    <option value="admin_expense">Admin Expense</option>
                    <option value="driver_salary">Driver Salary</option>
                    <option value="driver_commission">Driver Commission</option>
                    <option value="driver_bonus">Driver Bonus</option>
                    <option value="repayment">Loan Repayment</option>
                    <option value="other_expense">Other Expense</option>
                    <option value="petty_cash_expense">Petty Cash Expense</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-cash-coin text-danger"></i></div>
                <div class="stat-value amount-negative">M {{ total|floatformat:2 }}</div>
                <div class="stat-label">Total Expenses ({{ start_date|date:"d M" }} - {{ end_date|date:"d M Y" }})</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white"><i class="bi bi-pie-chart"></i> By Category</div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Category</th><th>Total</th></tr>
                    </thead>
                    <tbody>
                        {% for item in by_category %}
                        <tr>
                            <td>{{ item.get_category_display }}</td>
                            <td class="amount">M {{ item.total|floatformat:2 }}</td>
                        </tr>
                        {% empty %}
                        <tr><td colspan="2" class="text-center text-muted">No expenses</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-primary text-white"><i class="bi bi-list-ul"></i> Expense Transactions</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>Reference</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for e in expenses %}
                            <tr>
                                <td>{{ e.date|date:"d M Y" }}</td>
                                <td>{{ e.get_transaction_type_display }}</td>
                                <td>{{ e.get_category_display }}</td>
                                <td class="amount">M {{ e.amount|floatformat:2 }}</td>
                                <td>{{ e.reference|default:"-" }}</td>
                                <td>{{ e.notes|default:"-"|truncatechars:30 }}</td>
                            </tr>
                            {% empty %}
                            <tr><td colspan="6" class="text-center text-muted">No expenses found</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}