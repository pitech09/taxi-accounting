{% extends 'base.html' %}
{% block title %}Contract Settlements Report{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Contract Settlements Report</h2>
    <a href="{% url 'report_index' %}" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Reports</a>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-funnel"></i> Filters</div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Year</label>
                <input type="number" name="year" class="form-control" placeholder="e.g. 2026">
            </div>
            <div class="col-md-3">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    <option value="">All Months</option>
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-value">M {{ total_gross|floatformat:2 }}</div>
                <div class="stat-label">Total Gross</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-person"></i></div>
                <div class="stat-value text-success">M {{ total_driver_pay|floatformat:2 }}</div>
                <div class="stat-label">Total Driver Pay</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center stat-card">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-building"></i></div>
                <div class="stat-value text-primary">M {{ total_owner_pay|floatformat:2 }}</div>
                <div class="stat-label">Total Owner Pay</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white"><i class="bi bi-table"></i> Historical Contract Settlements</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Driver</th>
                        <th>Vehicle</th>
                        <th>Month</th>
                        <th>Target</th>
                        <th>Gross</th>
                        <th>Expenses</th>
                        <th>Profit</th>
                        <th>Success</th>
                        <th>Driver Pay</th>
                        <th>Owner Pay</th>
                        <th>Days</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in summaries %}
                    <tr>
                        <td>{{ s.driver.name }}</td>
                        <td>{{ s.vehicle.name }}</td>
                        <td>{{ s.month }}/{{ s.year }}</td>
                        <td class="amount">M {{ s.target|floatformat:2 }}</td>
                        <td class="amount">M {{ s.total_gross|floatformat:2 }}</td>
                        <td class="amount">M {{ s.total_expenses|floatformat:2 }}</td>
                        <td class="amount">M {{ s.gross_profit|floatformat:2 }}</td>
                        <td>
                            {% if s.is_success %}
                            <span class="badge bg-success">Success</span>
                            {% else %}
                            <span class="badge bg-danger">Failed</span>
                            {% endif %}
                        </td>
                        <td class="amount">M {{ s.driver_pay|floatformat:2 }}</td>
                        <td class="amount">M {{ s.owner_pay|floatformat:2 }}</td>
                        <td>{{ s.days_worked }}</td>
                    </tr>
                    {% empty %}
                    <tr><td colspan="11" class="text-center text-muted">No contract settlements found</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}