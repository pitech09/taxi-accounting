class SettlementBaseTestCase(TestCase):
    """Base test case with common setup for all model tests."""

    def setUp(self):
        self.admin_user = User.objects.create_user(
            username='testadmin', password='testpass123', is_staff=True
        )

    def _create_vehicle(self, **kwargs):
        defaults = {
            'name': 'Test Vehicle',
            'vehicle_type': 'sedan',
            'seats': 4,
            'plate': f'TEST-{kwargs.get("operating_model", "test")}-{Vehicle.objects.count()}',
            'operating_model': 'quota',
        }
        defaults.update(kwargs)
        return Vehicle.objects.create(**defaults)

    def _create_driver(self, vehicle, **kwargs):
        defaults = {
            'name': 'Test Driver',
            'phone': f'+266 5000 {Driver.objects.count():04d}',
            'vehicle': vehicle,
        }
        defaults.update(kwargs)
        return Driver.objects.create(**defaults)

    def _create_settlement(self, vehicle, driver, **kwargs):
        defaults = {
            'vehicle': vehicle,
            'driver': driver,
            'date': kwargs.pop('date', date.today()),
            'cash_collected': Decimal('500.00'),
            'mobile_collected': Decimal('200.00'),
            'card_collected': Decimal('100.00'),
            'fuel_cost': Decimal('150.00'),
            'toll_cost': Decimal('50.00'),
            'driver_allowance': Decimal('80.00'),
            'status': 'approved',
            'approved_at': timezone.now(),
            'approved_by': self.admin_user,
        }
        defaults.update(kwargs)
        return DailySettlement.objects.create(**defaults)


class QuotaModelTests(SettlementBaseTestCase):
    """Tests for the Quota operating model."""

    def setUp(self):
        super().setUp()
        self.vehicle = self._create_vehicle(
            operating_model='quota',
            daily_quota=Decimal('250.00'),
        )
        self.driver = self._create_driver(self.vehicle)

    def test_quota_surplus(self):
        """Driver makes more than quota - keeps surplus."""
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            cash_collected=Decimal('600.00'),
            mobile_collected=Decimal('200.00'),
            fuel_cost=Decimal('100.00'),
            toll_cost=Decimal('50.00'),
        )
        # Total income = 800, expenses = 150, gross_profit = 650
        # Quota = 250, surplus = 650 - 250 = 400
        self.assertEqual(settlement.daily_quota, Decimal('250.00'))
        self.assertEqual(settlement.surplus_shortfall, Decimal('400.00'))
        self.assertEqual(settlement.driver_pay, Decimal('400.00'))
        self.assertEqual(settlement.new_debt, Decimal('0'))
        self.assertEqual(settlement.debt_status, 'clear')

    def test_quota_shortfall_creates_debt(self):
        """Driver makes less than quota - debt is created."""
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            cash_collected=Decimal('100.00'),
            mobile_collected=Decimal('50.00'),
            fuel_cost=Decimal('80.00'),
            toll_cost=Decimal('20.00'),
        )
        # Total income = 150, expenses = 100, gross_profit = 50
        # Quota = 250, shortfall = 50 - 250 = -200
        self.assertEqual(settlement.surplus_shortfall, Decimal('-200.00'))
        self.assertEqual(settlement.new_debt, Decimal('200.00'))
        self.assertEqual(settlement.driver_pay, Decimal('0'))
        self.assertEqual(settlement.debt_status, 'owing')

    def test_quota_debt_repaid(self):
        """Driver with previous debt repays it from surplus."""
        # First settlement creates debt
        s1 = self._create_settlement(
            self.vehicle, self.driver,
            date=date.today() - timedelta(days=1),
            cash_collected=Decimal('100.00'),
            fuel_cost=Decimal('80.00'),
        )
        self.assertEqual(s1.new_debt, Decimal('230.00'))  # 20 - 250 = -230

        # Second settlement with surplus repays debt
        s2 = self._create_settlement(
            self.vehicle, self.driver,
            date=date.today(),
            cash_collected=Decimal('800.00'),
            fuel_cost=Decimal('100.00'),
        )
        # gross_profit = 700, quota = 250, surplus = 450
        # previous_debt = 230, debt_repaid = min(230, 450) = 230
        # new_debt = 230 - 230 = 0
        # driver_pay = 450 - 230 = 220
        self.assertEqual(s2.previous_debt, Decimal('230.00'))
        self.assertEqual(s2.debt_repaid, Decimal('230.00'))
        self.assertEqual(s2.new_debt, Decimal('0'))
        self.assertEqual(s2.driver_pay, Decimal('220.00'))
        self.assertEqual(s2.debt_status, 'clear')

    def test_quota_owner_collected(self):
        """Owner collects quota plus any debt repayment."""
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            cash_collected=Decimal('600.00'),
            fuel_cost=Decimal('100.00'),
        )
        # gross_profit = 500, quota = 250
        # quota_paid = 250, debt_repaid = 0
        # total_owner_collected = 250 + 0 = 250
        self.assertEqual(settlement.quota_paid_to_owner, Decimal('250.00'))
        self.assertEqual(settlement.total_owner_collected, Decimal('250.00'))


class SalaryModelTests(SettlementBaseTestCase):
    """Tests for the Salary operating model."""

    def setUp(self):
        super().setUp()
        self.vehicle = self._create_vehicle(
            operating_model='salary',
            monthly_salary=Decimal('3000.00'),
        )
        self.driver = self._create_driver(self.vehicle)

    def test_salary_daily_earned(self):
        """Driver earns daily salary = monthly / 30."""
        settlement = self._create_settlement(self.vehicle, self.driver)
        # daily_salary = 3000 / 30 = 100
        self.assertEqual(settlement.daily_salary_earned, Decimal('100.00'))
        self.assertEqual(settlement.driver_pay, Decimal('100.00'))

    def test_salary_owner_collects_rest(self):
        """Owner collects gross profit minus driver's daily salary."""
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            cash_collected=Decimal('500.00'),
            fuel_cost=Decimal('100.00'),
        )
        # gross_profit = 400, driver_pay = 100
        # owner_collected = 400 - 100 = 300
        self.assertEqual(settlement.driver_pay, Decimal('100.00'))
        self.assertEqual(settlement.total_owner_collected, Decimal('300.00'))

    def test_salary_override(self):
        """Driver salary override takes precedence."""
        self.driver.monthly_salary_override = Decimal('4500.00')
        self.driver.save()
        settlement = self._create_settlement(self.vehicle, self.driver)
        # daily_salary = 4500 / 30 = 150
        self.assertEqual(settlement.daily_salary_earned, Decimal('150.00'))


