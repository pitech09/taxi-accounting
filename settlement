class SettlementPeriodTests(SettlementBaseTestCase):
    """Tests for daily/weekly settlement periods."""

    def setUp(self):
        super().setUp()
        self.vehicle = self._create_vehicle(operating_model='quota')
        self.driver = self._create_driver(self.vehicle)

    def test_daily_settlement(self):
        """Daily settlement has correct period."""
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            settlement_period='daily',
        )
        self.assertEqual(settlement.settlement_period, 'daily')
        self.assertIsNone(settlement.week_start)
        self.assertIsNone(settlement.week_end)

    def test_weekly_settlement(self):
        """Weekly settlement has week start and end."""
        today = date.today()
        monday = today - timedelta(days=today.weekday())
        sunday = monday + timedelta(days=6)
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            settlement_period='weekly',
            week_start=monday,
            week_end=sunday,
        )
        self.assertEqual(settlement.settlement_period, 'weekly')
        self.assertEqual(settlement.week_start, monday)
        self.assertEqual(settlement.week_end, sunday)