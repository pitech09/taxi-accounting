class ContractModelTests(SettlementBaseTestCase):
    """Tests for the Contract operating model."""

    def setUp(self):
        super().setUp()
        self.vehicle = self._create_vehicle(
            vehicle_type='bus',
            seats=30,
            operating_model='contract',
            contract_target=Decimal('5000.00'),
            contract_success_bonus_type='fixed',
            contract_success_bonus_fixed=Decimal('1000.00'),
            contract_success_bonus_percentage=Decimal('10.00'),
            contract_failure_percentage=Decimal('20.00'),
        )
        self.driver = self._create_driver(self.vehicle)

    def test_contract_below_target(self):
        """When below target, driver gets failure percentage of gross."""
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            cash_collected=Decimal('500.00'),
        )
        # monthly_gross = 500, target = 5000, below target
        # failure_pay = 20% of 500 = 100
        self.assertFalse(settlement.contract_is_success)
        self.assertEqual(settlement.contract_driver_pay, Decimal('100.00'))
        self.assertEqual(settlement.driver_pay, Decimal('100.00'))

    def test_contract_above_target(self):
        """When above target, driver gets success bonus."""
        # Create enough settlements to exceed target
        for i in range(10):
            self._create_settlement(
                self.vehicle, self.driver,
                date=date.today() - timedelta(days=10 - i),
                cash_collected=Decimal('600.00'),
            )
        last = DailySettlement.objects.filter(driver=self.driver).latest('date')
        # monthly_gross = 6000, target = 5000, success!
        # bonus = 1000 (fixed), split across 10 settlements = 100 each
        self.assertTrue(last.contract_is_success)
        self.assertEqual(last.contract_driver_bonus, Decimal('1000.00'))

    def test_contract_remaining_target(self):
        """Remaining target is calculated correctly."""
        settlement = self._create_settlement(
            self.vehicle, self.driver,
            cash_collected=Decimal('1000.00'),
        )
        # monthly_gross = 1000, target = 5000, remaining = 4000
        self.assertEqual(settlement.contract_remaining_target, Decimal('4000.00'))


class ApprovalWorkflowTests(SettlementBaseTestCase):
    """Tests for the approval workflow."""

    def setUp(self):
        super().setUp()
        self.vehicle = self._create_vehicle(operating_model='quota')
        self.driver = self._create_driver(self.vehicle)

    def test_draft_settlement_no_calculations(self):
        """Draft settlements should not have calculations applied."""
        settlement = DailySettlement.objects.create(
            vehicle=self.vehicle,
            driver=self.driver,
            date=date.today(),
            cash_collected=Decimal('500.00'),
            fuel_cost=Decimal('100.00'),
            status='draft',
        )
        self.assertEqual(settlement.driver_pay, Decimal('0'))
        self.assertEqual(settlement.total_owner_collected, Decimal('0'))
        self.assertEqual(settlement.daily_quota, Decimal('0'))

    def test_submitted_settlement_no_calculations(self):
        """Submitted settlements should not have calculations applied."""
        settlement = DailySettlement.objects.create(
            vehicle=self.vehicle,
            driver=self.driver,
            date=date.today(),
            cash_collected=Decimal('500.00'),
            fuel_cost=Decimal('100.00'),
            status='submitted',
            submitted_at=timezone.now(),
        )
        self.assertEqual(settlement.driver_pay, Decimal('0'))
        self.assertEqual(settlement.total_owner_collected, Decimal('0'))

    def test_approved_settlement_has_calculations(self):
        """Approved settlements should have calculations applied."""
        settlement = DailySettlement.objects.create(
            vehicle=self.vehicle,
            driver=self.driver,
            date=date.today(),
            cash_collected=Decimal('500.00'),
            fuel_cost=Decimal('100.00'),
            status='approved',
            approved_at=timezone.now(),
            approved_by=self.admin_user,
        )
        self.assertGreater(settlement.driver_pay, Decimal('0'))
        self.assertGreater(settlement.total_owner_collected, Decimal('0'))
        self.assertEqual(settlement.daily_quota, Decimal('250.00'))

    def test_rejected_settlement_no_calculations(self):
        """Rejected settlements should not have calculations."""
        settlement = DailySettlement.objects.create(
            vehicle=self.vehicle,
            driver=self.driver,
            date=date.today(),
            cash_collected=Decimal('500.00'),
            fuel_cost=Decimal('100.00'),
            status='rejected',
        )
        self.assertEqual(settlement.driver_pay, Decimal('0'))
        self.assertEqual(settlement.total_owner_collected, Decimal('0'))

    def test_income_expenses_always_calculated(self):
        """Income and expenses should be calculated regardless of status."""
        settlement = DailySettlement.objects.create(
            vehicle=self.vehicle,
            driver=self.driver,
            date=date.today(),
            cash_collected=Decimal('500.00'),
            mobile_collected=Decimal('200.00'),
            fuel_cost=Decimal('100.00'),
            toll_cost=Decimal('50.00'),
            status='draft',
        )
        self.assertEqual(settlement.total_income, Decimal('700.00'))
        self.assertEqual(settlement.total_expenses, Decimal('150.00'))
        self.assertEqual(settlement.gross_profit, Decimal('550.00'))


